# ─────────────────────────────────────────────────────────────────────────────
# Environment variables reference (copy to .env.local for local dev, or set in
# the Vercel project → Settings → Environment Variables for a deployment).
#
# NOTE: this file lists variable NAMES only — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Level gating (public release control) ───────────────────────────────────
# Gating is decided PER DOMAIN in code (src/lib/enabledLevels.ts):
#   • the public release domain (bulgarian-for-refugees-unhcr.vercel.app) → A1 + A2
#   • every other domain (internal, previews, localhost)                  → all levels
# So NO env var is required for the normal setup — just point the public domain
# at this same project. To release a further level publicly, add it to
# PUBLIC_RELEASE_LEVELS in src/lib/enabledLevels.ts.
#
# OPTIONAL, both unset by default:
#   NEXT_PUBLIC_A1_ONLY_HOSTS   Comma-separated hostnames pinned back to A1 only
#                               (emergency rollback without touching code).
#   NEXT_PUBLIC_ENABLED_LEVELS  Global override for the WHOLE deployment regardless of
#                               host (e.g. "a1" or "a1,a2"). Leave unset normally.
# NEXT_PUBLIC_A1_ONLY_HOSTS=
# NEXT_PUBLIC_ENABLED_LEVELS=

# Public base URL of THIS deployment (used in password-reset emails, etc.)
# e.g. https://bulgarian-for-refugees.vercel.app
NEXT_PUBLIC_APP_URL=

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# SAME connection string as the existing deployment → same tables & data.
DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=
# Comma-separated admin emails granted IT-admin access on first login.
IT_ADMIN_EMAILS=

# ── Email (Resend — password reset) ──────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── AI chat / speech-to-text (OpenAI) ────────────────────────────────────────
OPENAI_API_KEY=
# Optional overrides (sensible defaults exist in code):
OPENAI_STT_MODEL=
OPENAI_STT_FALLBACK_MODEL=
CHAT_RATE_LIMIT_PER_HOUR=
STT_RATE_LIMIT_PER_HOUR=
